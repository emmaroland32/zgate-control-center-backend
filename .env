# ─── ZGATE Nexus Backend — Environment Variables ──────────────────────────────
# Copy to .env for local development.
# In production, inject these as container/host environment variables.
# Never commit the real .env to version control.

# Spring profile: 'dev' (default) or 'prod'
SPRING_PROFILES_ACTIVE=dev

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8090

# Database Configuration
DB_HOST=fintribe.cfrolh4juysa.eu-west-2.rds.amazonaws.com
DB_PORT=5223
DB_NAME=zgate_nexus
DB_USERNAME=fintribe_api
DB_PASSWORD=6*i47\#stu<V{Z~ds3-45T)3XCtxz

# ─── JWT ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-use-openssl-rand-base64-48-in-production
JWT_EXPIRATION_MS=86400000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
CORS_ALLOWED_ORIGINS=http://localhost:3002

# ─── Mail (for invoice delivery) ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── Billing ─────────────────────────────────────────────────────────────────
TAX_RATE=0.15
INVOICE_DUE_DAYS=30
DEFAULT_CURRENCY=USD

# ─── License signing key ─────────────────────────────────────────────────────
NEXUS_LICENSE_PRIVATE_KEY_PATH=control-center/backend/license/nexus-license-private.pem

# ─── Health check ────────────────────────────────────────────────────────────
HEALTH_CHECK_TIMEOUT=5
