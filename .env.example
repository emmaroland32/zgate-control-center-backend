# ─── ZGATE Control Center Backend — Environment Variables ──────────────────────────────
# Copy to .env for local development.
# In production, inject these as container/host environment variables.
# Never commit the real .env to version control.

# Spring profile: 'dev' (default) or 'prod'
SPRING_PROFILES_ACTIVE=dev

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8090

# ─── Database (standalone zgate_control_center DB) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zgate_control_center
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ─── JWT ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-use-openssl-rand-base64-48-in-production
JWT_EXPIRATION_MS=86400000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
CORS_ALLOWED_ORIGINS=http://localhost:3002

# ─── Mail (for invoice delivery) ─────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── Billing ─────────────────────────────────────────────────────────────────
TAX_RATE=0.15
INVOICE_DUE_DAYS=30
DEFAULT_CURRENCY=USD

# ─── Health check ────────────────────────────────────────────────────────────
HEALTH_CHECK_TIMEOUT=5

# ── Single sign-on (OIDC) ─────────────────────────────────────────────────────
# Optional. Password sign-in stays available alongside SSO as break-glass.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Secret — treat like JWT_SECRET. Never commit a real value.
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Blank means SSO NEVER creates operators (the account must already exist). Only VIEWER or
# SUPPORT are accepted; setting a role grants it to everyone your IdP can authenticate.
OIDC_AUTO_PROVISION_ROLE=
